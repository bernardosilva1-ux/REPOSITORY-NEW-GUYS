body {
  margin: 0;
  font-family: Arial;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

header, footer {
  background: purple;
  color: white;
  text-align: center;
  padding: 15px;
}

main {
  display: flex;
  flex: 1;
  gap: 10px;
  padding: 10px;
}

article {
  flex: 1;
  background: gray;
  color: white;
  padding: 20px;
}