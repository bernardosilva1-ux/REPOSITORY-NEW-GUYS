body {
  margin: 0;
  font-family: Arial;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

header, footer {
  background: blue;
  color: white;
  text-align: center;
  padding: 15px;
}

main {
  flex: 1;
  padding: 10px;
}

section {
  margin: 10px 0;
  padding: 20px;
  background: lightgray;
}